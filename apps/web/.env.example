# Midnight network: preprod (default), preview or undeployed (local devnet).
VITE_NETWORK_ID=preprod
# Registry to use. Defaults to the public CarbonSeal registry on preprod.
VITE_CONTRACT_ADDRESS=
# Blockfrost project token for the hosted indexer. Server side only: the dev
# and preview servers proxy /indexer and add it there. Put it in .env.local.
BLOCKFROST_PROJECT_ID=
# Optional: call an indexer directly instead of the /indexer proxy.
VITE_INDEXER_URL=
VITE_INDEXER_WS_URL=
